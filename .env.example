# --- Database -------------------------------------------------------------
# SQLite for the initial deployment. To migrate to PostgreSQL, change the
# provider in prisma/schema.prisma to "postgresql" and point this at the
# Postgres URL — no application code changes are required.
DATABASE_URL="file:./dev.db"

# --- Auth -----------------------------------------------------------------
# 32+ random bytes. Used to derive the session cookie signature.
AUTH_SECRET="change-me-to-a-long-random-string"
# Session lifetime in hours.
SESSION_TTL_HOURS="12"
# Set to "true" in production so cookies are Secure-only.
COOKIE_SECURE="false"

# --- Storage --------------------------------------------------------------
# LOCAL | S3 (S3 driver is a documented extension point, not yet wired)
STORAGE_DRIVER="LOCAL"
STORAGE_LOCAL_DIR="./storage"
# Public base path that maps to the storage directory.
STORAGE_PUBLIC_BASE="/api/files"

# --- Seed -----------------------------------------------------------------
# For `npm run db:seed` (demo/dev data only — ~450 fake accounts, 100+ fake
# teams, all clearly marked [Demo] and @seed.piemr.edu.in). Never run this
# against a real deployment's database.
SEED_PASSWORD="Piemr@2026"

# For `npm run db:init` (a real deployment's first run — creates the real
# department/semester/project-type structure and exactly one real Super Admin
# account, no fake data at all). Prefer passing these as one-off environment
# variables on the command line instead of committing real credentials here:
#   ADMIN_NAME="Your Name" ADMIN_EMAIL="you@example.edu" \
#   ADMIN_PASSWORD="a-strong-password" npm run db:init
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Institution customization (optional) --------------------------------
# COLLEGE_NAME="Prestige Institute of Engineering Management & Research"
# COLLEGE_CODE="PIEMR"
# NEXT_PUBLIC_COLLEGE_NAME="Prestige Institute of Engineering Management & Research"
# NEXT_PUBLIC_COLLEGE_CODE="PIEMR"

# --- Footer credit (optional) ----------------------------------------------
# Never hardcoded in source — set locally if you want a named credit on the
# public pages. This file (.env) is gitignored; keep any real name/email here
# and never paste them into a committed file, README example, or commit
# message.
# CREDIT_NAME_1=
# CREDIT_TITLE_1=
# CREDIT_EMAIL_1=
# CREDIT_NAME_2=
# CREDIT_EMAIL_2=
# CREDIT_LINKEDIN_2=
